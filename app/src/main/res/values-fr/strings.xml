    <!-- Fonctionnalités (FR vouvoiement) -->
    <string name="feature_voice_title">Mot-clé vocal</string>
    <string name="feature_voice_desc">Déclenchez l\'urgence automatiquement en prononçant un mot-clé (ex. « au secours », « appelle le 112 »). Utilise le moteur Vosk local — aucun cloud.</string>

    <string name="feature_cascade_title">Cascade d\'appels automatique</string>
    <string name="feature_cascade_desc">Appelle vos contacts d\'urgence l\'un après l\'autre jusqu\'à ce que quelqu\'un réponde. Nécessite la permission READ_PHONE_STATE.</string>

    <string name="feature_siren_title">Sirène + flash</string>
    <string name="feature_siren_desc">Déclenche une alarme sonore et un stroboscope avec la lampe arrière. Arrêt automatique après 5 minutes. Nécessite la permission CAMERA.</string>

    <string name="feature_livegps_title">GPS en direct</string>
    <string name="feature_livegps_desc">Envoie votre position en temps réel à vos contacts d\'urgence toutes les 30 s pendant 5 minutes maximum. Nécessite la localisation en arrière-plan.</string>

    <string name="feature_recording_title">Enregistrement audio</string>
    <string name="feature_recording_desc">Enregistre l\'audio ambiant et le chiffre dans votre coffre sécurisé local. Avertissement légal obligatoire avant activation.</string>

    <string name="feature_webhook_title">Alerte webhook</string>
    <string name="feature_webhook_desc">Envoie un payload JSON minimal à l\'URL configurée lors d\'un déclenchement d\'urgence. Aucune donnée personnelle n\'est transmise.</string>

    <string name="feature_contacts_title">Contacts d\'urgence</string>
    <string name="feature_contacts_desc">Configurez qui appeler et prévenir en cas d\'urgence. Stocké localement — jamais synchronisé avec un serveur.</string>

    <string name="feature_coming_soon">Cette fonctionnalité sera entièrement implémentée en v0.2.\n\nLes contrats et les écrans de configuration sont prêts — implémentation à venir.</string>

