    <!-- Feature titles + descriptions (EN) -->
    <string name="feature_voice_title">Voice keyword</string>
    <string name="feature_voice_desc">Trigger emergency automatically when you say a keyword (e.g. \'help\', \'call 112\'). Uses Vosk local model — no cloud.</string>

    <string name="feature_cascade_title">Automatic call cascade</string>
    <string name="feature_cascade_desc">Calls your emergency contacts one by one until someone answers. Requires READ_PHONE_STATE permission.</string>

    <string name="feature_siren_title">Siren + flash</string>
    <string name="feature_siren_desc">Triggers an audio alarm and rear flashlight strobe. Auto-stops after 5 minutes. Requires CAMERA permission.</string>

    <string name="feature_livegps_title">Live GPS sharing</string>
    <string name="feature_livegps_desc">Sends your real-time location to your emergency contacts every 30 s for up to 5 minutes. Requires background location permission.</string>

    <string name="feature_recording_title">Call recording</string>
    <string name="feature_recording_desc">Records ambient audio and encrypts it in your local secure vault. Legal disclaimer required before activation.</string>

    <string name="feature_webhook_title">Webhook alert</string>
    <string name="feature_webhook_desc">Sends a minimal JSON payload to your configured URL when an emergency is triggered. No personal data is shared.</string>

    <string name="feature_contacts_title">Emergency contacts</string>
    <string name="feature_contacts_desc">Configure who to call and message in an emergency. Stored locally — never synced to any server.</string>

    <string name="feature_coming_soon">This feature will be fully implemented in v0.2.\n\nThe contracts and configuration screens are ready — implementation coming soon.</string>

