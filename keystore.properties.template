# Rename this file to keystore.properties and fill in your values.
# NEVER commit keystore.properties to git (it is in .gitignore).
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore sos_tech_release.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias sos_tech
#
storeFile=../sos_tech_release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=sos_tech
keyPassword=YOUR_KEY_PASSWORD
